# Everything here is optional. With no values set, the site still works:
# progress is saved in the visitor's browser, and music plays from the track list in src/data/youtube-videos.json.

# Sign-in + cross-device sync + the global "N people planked today" counter.
# Supabase dashboard -> Project Settings -> API. Use the publishable (anon) key, never the secret key.
VITE_SUPABASE_URL=
VITE_SUPABASE_KEY=

# Only used by `npm run sync:youtube` to refresh the album tracks (never shipped to the browser).
# Google Cloud Console -> enable "YouTube Data API v3" -> Credentials -> Create API key.
YOUTUBE_API_KEY=
