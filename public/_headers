# Security headers for every page, applied by Cloudflare Pages.
# The Content-Security-Policy lets the page run only its own scripts, YouTube's player, and the theme
# script in index.html (by its hash: src/lib/securityHeaders.test.ts checks it). Pictures and requests
# go only to the site and Supabase, so even an injected script couldn't send anything anywhere else.
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()
  Content-Security-Policy: default-src 'self'; script-src 'self' 'sha256-R1JnFfnAytPY4MmmTzvKeyBC1PskoydUbjICMBn7+Sw=' https://www.youtube.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; img-src 'self' data: blob: https://*.supabase.co; connect-src 'self' https://*.supabase.co; frame-src https://www.youtube-nocookie.com https://www.youtube.com; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'

# The service worker: always checked for a new copy, so a deploy that changes it takes effect straight away.
/sw.js
  Cache-Control: no-cache

# Today's song for the year ahead (made by the build): checked on every read, so a new release shows the same day.
/daily.json
  Cache-Control: no-cache
