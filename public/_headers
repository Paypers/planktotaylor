# Security headers for every page, applied by Cloudflare Pages.
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()
  Content-Security-Policy: base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'

# The service worker: always checked for a new copy, so a deploy that changes it takes effect straight away.
/sw.js
  Cache-Control: no-cache

# Today's song for the year ahead (made by the build): checked on every read, so a new release shows the same day.
/daily.json
  Cache-Control: no-cache
